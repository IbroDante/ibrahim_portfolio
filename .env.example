# Brevo Transactional Email API Configuration
# Get your v3 API key from: Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_v3_api_key_here

# Verified sender email attached to your Brevo account
BREVO_SENDER_EMAIL=mololuwa.ibrahim@gmail.com
BREVO_SENDER_NAME=Ibrahim Balogun Portfolio

# Public website email that receives all contact form submissions
CONTACT_RECIPIENT_EMAIL=ibroman02@yahoo.com
CONTACT_RECIPIENT_NAME=Ibrahim Balogun

# Optional Flask runtime settings
FLASK_ENV=production
PORT=5000
